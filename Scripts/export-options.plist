<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight distribution. Xcode 15.3 renamed this value from
	     "app-store"; the pipeline requires Xcode 16 or newer. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>7GNFT94A9L</string>
	<!-- Manual: the archive is already signed with the Apple Distribution
	     identity and App Store profile installed by Scripts/signing-identity.sh.
	     Automatic signing would ask Apple for a development profile, which a
	     team with no registered devices cannot be issued. signingCertificate
	     and provisioningProfiles are added at run time by Scripts/release-ios.sh,
	     because the profile name is only known then. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- The build number is chosen from App Store Connect before archiving; let
	     Xcode rewrite it and that choice is silently discarded. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<!-- Ship the archive's own bitcode-free binary as built; no thinning. -->
	<key>stripSwiftSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
